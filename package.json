{
  "name": "aflt",
  "version": "1.4.0",
  "description": "Track, resume, and headlessly run Cursor, Copilot, and OpenCode CLI sessions",
  "bin": {
    "agentfleet": "bin/af.js",
    "af": "bin/af.js",
    "aflt": "bin/af.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --import ./test/_setup.js --test --test-concurrency=1 test/*.test.js",
    "af": "node bin/af.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "files": [
    "bin",
    "lib",
    "herdr",
    "!herdr/**/gpui-kit.d.ts",
    "completions",
    "templates",
    "docs",
    "examples",
    "README.md",
    "AGENTS.md",
    "assets",
    "LICENSE"
  ],
  "keywords": [
    "cursor",
    "cursor-agent",
    "copilot",
    "opencode",
    "cli",
    "tmux",
    "iterm2",
    "wezterm"
  ],
  "license": "MIT",
  "author": "Andrew Rapo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwlib/aflt.git"
  },
  "homepage": "https://aflt.dev",
  "bugs": {
    "url": "https://github.com/wwlib/aflt/issues"
  }
}
